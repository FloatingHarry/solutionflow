DATABASE_URL=postgresql+psycopg://solutionflow:solutionflow@localhost:5433/solutionflow
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
LOG_LEVEL=INFO
RESEARCH_PROVIDER=mock
RESEARCH_RUN_INLINE=false
# Paste your project API key after the equals sign in the local .env file.
# Never commit a real key. The application reads this value on the API server only.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
# Account Agent uses OpenAI automatically when a key is present; set to guided to force local mode.
AGENT_PROVIDER=auto
OPENAI_AGENT_MODEL=gpt-5.6-luna
